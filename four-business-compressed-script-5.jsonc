      {
        "typeId": "RestaurantBlueprint",
        "oopKind": "CONCRETE_DERIVED_BLUEPRINT_TYPE",
        "extends": "BaseBusinessApplicationBlueprint",
        "inherits": [
          "identityContract",
          "ownerContract",
          "localeContract",
          "themeContract",
          "entityRegistryContract",
          "relationshipRegistryContract",
          "workflowRegistryContract",
          "administrationContract",
          "partitionContract",
          "introspectionContract"
        ],
        "overrides": {
          "applicationId": "MARIE_RESTAURANT",
          "businessType": "Restaurant",
