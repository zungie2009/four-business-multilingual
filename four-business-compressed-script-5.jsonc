{
  "format": "LLM_OOP_BLUEPRINT_CONSTRUCTION_CONTRACT_V1",
  "experiment": {
    "name": "OOP Blueprint Script Convention Experiment",
    "purpose": "Test whether ChatGPT, Claude and Gemini can construct the same validated four-business software from an explicitly object-oriented LLM script.",
    "hypothesis": "An LLM construction script can be developed as an OOP model with base types, derived Blueprint types, object instances, encapsulation, composition, association and polymorphic dispatch.",
    "controlSource": {
      "format": "LLM_AST_TOKEN_MANIFEST_V4",
      "compilerVersion": "1.4",
      "sha256": "da868c3334ae2b29d342fa6cbca019b7132ba71f8e34812326970ff2e3abd9be"
    },
    "variableUnderTest": "REPRESENTATION_CHANGED_FROM_TOKENIZED_HIERARCHY_TO_EXPLICIT_OOP_BLUEPRINT_MODEL",
    "semanticChangePermitted": false
  },
  "target": {
    "software": "PLAIN_JAVA_LOCAL_WEB_APPLICATION",
    "javaVersion": 21,
    "externalRuntimeDependencies": "NONE_REQUIRED",
    "models": [
      "ChatGPT",
      "Claude",
      "Gemini"
    ],
    "instruction": "Implement the object model and all inherited, composed and associated contracts. Do not reinterpret the object hierarchy as four unrelated programs or merge the four business instances."
  },
  "oopVocabulary": {
    "extends": "The derived Blueprint inherits the Base Blueprint contract and specializes its declared variation points.",
    "instanceOf": "The object is a runtime instance of the declared type.",
    "configuredBy": "The runtime object delegates domain structure and behavior to the referenced immutable Blueprint.",
    "composes": "The owner exclusively owns the lifecycle and state boundary of the contained objects.",
    "associatesWith": "The object uses another object without acquiring ownership of its mutable state.",
    "governedBy": "The state machine controls allowed transitions for the subject object.",
    "polymorphicDispatch": "The same operation is resolved from the active BusinessApplication and its Blueprint context.",
    "encapsulationBoundary": "Mutable state cannot be read or written outside the declared business partition."
  },
  "typeSystem": {
    "interfaces": [
      {
        "typeId": "IntrospectableBlueprint",
        "operations": [
          "describeSelf",
          "entities",
          "relationships",
          "stateMachines",
          "validate"
        ]
      },
      {
        "typeId": "BusinessApplicationContract",
        "operations": [
          "render",
          "createRecord",
          "readRecord",
          "updateRecord",
          "deleteRecord",
          "transitionState",
          "administration",
          "introspect"
        ]
      },
      {
        "typeId": "BusinessContextAwareService",
        "operations": [
          "executeWith(BusinessContext context)"
        ]
      }
    ],
    "abstractTypes": [
      {
        "typeId": "BaseBusinessApplicationBlueprint",
        "oopKind": "ABSTRACT_BASE_BLUEPRINT",
        "implements": [
          "IntrospectableBlueprint"
        ],
        "immutable": true,
        "properties": {
          "applicationId": "ApplicationId",
          "businessType": "String",
          "language": "String",
          "locale": "LocaleId",
          "defaultTheme": "ThemeId",
          "allowedThemes": "List<ThemeId>",
          "entities": "List<EntityDefinition>",
          "relationships": "List<RelationshipDefinition>",
          "stateMachines": "List<StateMachineDefinition>",
          "administrationScope": "AdministrationScope"
        },
        "inheritedBehavior": [
          "Validate typed fields and localized enum labels.",
          "Validate displayField and secondaryDisplayField picker bindings.",
          "Validate same-partition relationships and delete restriction.",
          "Validate that every workflow subject and state transition resolves.",
          "Expose complete structure through introspection."
        ],
        "variationPoints": [
          "domain entities",
          "relationships",
          "workflows",
          "locale",
          "themes",
          "localized labels"
        ]
      },
      {
        "typeId": "ContextualSharedService",
        "oopKind": "ABSTRACT_SHARED_SERVICE",
        "implements": [
          "BusinessContextAwareService"
        ],
        "invariant": "The service is shared, but every operation is scoped by the active BusinessApplication context and must not merge mutable business state."
      }
    ],
    "concreteRuntimeTypes": [
      {
        "typeId": "BusinessApplication",
        "implements": [
          "BusinessApplicationContract"
        ],
        "properties": {
          "self": "ApplicationSelf",
          "blueprint": "BaseBusinessApplicationBlueprint",
          "partition": "PersistencePartition",
          "administrationState": "AdministrationState"
        },
        "constructor": "BusinessApplication(ApplicationSelf self, BaseBusinessApplicationBlueprint blueprint, PersistencePartition partition)",
        "dispatchRule": "All domain behavior, navigation, fields, labels, actions and workflows are obtained polymorphically from blueprint."
      }
    ],
    "derivedBlueprintTypes": [
      {
