  "polymorphicRuntime": {
    "resolution": "fourBusinessContainer.resolve(selectedUserId) returns exactly one BusinessApplication instance.",
    "rendering": "uiProjection.executeWith(activeApplication.context()) renders the active Blueprint and replaces the previous projection.",
    "recordOperation": "activeApplication dispatches an entity operation only when the entity is declared by its configured Blueprint.",
    "stateTransition": "activeApplication dispatches only a transition declared by the state machine composed into its configured Blueprint.",
    "administration": "administrationProjection reconstructs controls and values from the active application without merging another instance's state.",
    "prohibitedImplementation": "Do not implement domain switching with four duplicated applications or a business-name if/else chain when polymorphic Blueprint dispatch can provide the behavior."
  },
  "globalInvariants": [
    "BaseBusinessApplicationBlueprint contains common contracts, not shared mutable business data.",
    "Derived Blueprint types may specialize declared variation points but may not weaken isolation, routing, typing, audit or Administration requirements.",
    "BusinessApplication instances own separate SELF, runtime state, Administration state and persistence partitions.",
    "The UI uses REPLACE_NOT_MERGE projection.",
    "Shared physical persistence uses the full canonical compound storage key.",
    "Cross-business joins, references and overrides are prohibited.",
    "The user selector is demonstration behavior and is not production authentication.",
    "All prohibited-inference rules from the control script remain mandatory."
  ],
  "prohibitedInference": [
    "Do not invent entities such as TIME_ENTRY or fields such as totalAmount.",
    "Do not infer hourly-rate or invoice calculations; Invoice.amount is manual input.",
    "Do not add enum values such as Invoice.CANCELLED; use only declared enumValues.",
    "Do not silently implement suggested enhancements such as search; report them separately."
  ],
  "constructionPlan": [
    "Implement interfaces and BaseBusinessApplicationBlueprint.",
    "Implement the immutable four derived Blueprint types.",
    "Implement BusinessApplication as the common runtime object.",
    "Instantiate the four owner-bound BusinessApplication objects.",
    "Implement shared context-aware service objects.",
    "Wire composition, associations, entity references and lifecycle governance exactly as declared.",
    "Enforce global invariants at server boundaries and persistence boundaries.",
    "Render the full standalone Administration view.",
    "Run deterministic seeds once per partition.",
    "Generate and execute conformance tests before delivery."
  ],
  "constructionContract": {
    "target": "PLAIN_JAVA_LOCAL_WEB_APPLICATION",
    "requirements": [
      "Decode the complete V4 AST before implementation.",
      "Keep all four business applications independent; shared UI and persistence are infrastructure only.",
      "Render fields with declared controls and reference pickers with target displayField plus secondaryDisplayField.",
      "Store canonical enum values but display localized labels; allow state changes only through declared transition buttons.",
      "Implement the complete required standalone Administration navigation view, all declared controls, localized labels, save action, warning, re-projection, persistence, auditing, and acceptance scenarios; a theme-only implementation is noncompliant.",
      "Apply deterministic seeds once per partition and never reseed after user deletion.",
      "Emit declared audit events through Audit NEURON, not Administration.",
      "Persist themes and Administration across restart.",
      "Enforce canonical composite storage keys and server-resolved request context.",
      "The selector is demo behavior, not production authentication.",
      "Do not invent TIME_ENTRY, totalAmount, hourly calculations, Invoice.CANCELLED, search, or any other undeclared behavior.",
      "Report optional additions separately from implemented requirements.",
      "Deliver reproducible build and executable verification evidence."
    ],
    "scope": "CONTEXTUAL_MULTI_BUSINESS_SOFTWARE_CONSTRUCTION",
    "oopRequirements": [
      "Use one common BusinessApplication runtime abstraction.",
      "Use one immutable BaseBusinessApplicationBlueprint contract.",
      "Represent Consulting, Restaurant, Marketplace and Property Management as derived Blueprint types.",
      "Represent Robert, Sofia, Marie and Hans applications as separate runtime instances configured by those derived types.",
      "Use composition for owned entities and state machines, association for shared services, and typed references for entity relationships.",
      "Preserve polymorphic behavior without merging business state."
    ]
  },
  "semanticEquivalence": {
    "controlFormat": "LLM_AST_TOKEN_MANIFEST_V4",
    "controlSemanticValidation": {
      "contract": "MULTI_BUSINESS_SEMANTIC_PREFLIGHT_V4",
      "status": "PASS",
      "issues": [],
      "businessCount": 4,
      "entityCount": 13,
      "fieldCount": 40,
      "relationshipCount": 7,
      "workflowCount": 7,
      "typedFields": true,
      "stateTransitionsValidated": true,
      "separateBusinessSelves": true,
      "uniquePartitions": true,
      "duplicateEntityIdsAcrossPartitions": "ALLOWED_AND_SCOPED",
      "canonicalStorageKeyValidated": true,
      "requestContextValidated": true,
      "uiControlMappingsValidated": true,
      "pickerDisplayBindingsValidated": true,
      "localizedEnumLabelsValidated": true,
      "seedContractValidated": true,
