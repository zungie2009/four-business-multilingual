  "objectInstances": {
    "root": {
      "objectId": "fourBusinessContainer",
      "instanceOf": "FourBusinessContainer",
      "self": {
        "accessMode": "DEMONSTRATION_USER_SWITCHER",
        "defaultUser": "robert",
        "accessWarning": "The selector intentionally permits switching among all four demo identities; replace it with authenticated server-resolved identity for production.",
        "productionAuthentication": false,
        "childrenRemainIndependent": true,
        "id": "FOUR_BUSINESS_DEMO"
      },
      "composes": [
        "robertApplication",
        "sofiaApplication",
        "marieApplication",
        "hansApplication"
      ],
      "providesSharedServices": [
        "uiProjection",
        "persistenceService",
        "requestContextResolver",
        "administrationProjection",
        "auditService",
        "seedService"
      ]
    },
    "businessApplications": [
      {
        "objectId": "robertApplication",
        "instanceOf": "BusinessApplication",
        "configuredBy": "ConsultingCompanyBlueprint",
        "owner": {
          "person": "Robert",
          "userId": "robert"
        },
        "objectState": {
          "applicationId": "ROBERT_CONSULTING",
          "locale": "en-US",
          "theme": "professional-blue",
          "persistencePartition": "robert/robert_consulting",
          "administrationScope": "OWN_BUSINESS_ONLY"
        },
        "encapsulationBoundary": "OWN_BUSINESS_ONLY"
      },
      {
        "objectId": "sofiaApplication",
        "instanceOf": "BusinessApplication",
        "configuredBy": "PropertyManagementBlueprint",
        "owner": {
          "person": "Sofia",
          "userId": "sofia"
        },
        "objectState": {
          "applicationId": "SOFIA_PROPERTY",
          "locale": "es-ES",
          "theme": "calm-property",
          "persistencePartition": "sofia/sofia_property",
          "administrationScope": "OWN_BUSINESS_ONLY"
        },
        "encapsulationBoundary": "OWN_BUSINESS_ONLY"
      },
      {
        "objectId": "marieApplication",
        "instanceOf": "BusinessApplication",
        "configuredBy": "RestaurantBlueprint",
        "owner": {
          "person": "Marie",
          "userId": "marie"
        },
        "objectState": {
          "applicationId": "MARIE_RESTAURANT",
          "locale": "fr-FR",
          "theme": "warm-hospitality",
          "persistencePartition": "marie/marie_restaurant",
          "administrationScope": "OWN_BUSINESS_ONLY"
        },
        "encapsulationBoundary": "OWN_BUSINESS_ONLY"
      },
      {
        "objectId": "hansApplication",
        "instanceOf": "BusinessApplication",
        "configuredBy": "MarketplaceBlueprint",
        "owner": {
          "person": "Hans",
          "userId": "hans"
        },
        "objectState": {
          "applicationId": "HANS_MARKETPLACE",
          "locale": "de-DE",
          "theme": "structured-commerce",
          "persistencePartition": "hans/hans_marketplace",
          "administrationScope": "OWN_BUSINESS_ONLY"
        },
        "encapsulationBoundary": "OWN_BUSINESS_ONLY"
      }
    ],
    "sharedServices": [
      {
        "objectId": "uiProjection",
        "instanceOf": "ContextualSharedService",
        "specialization": "UIProjectionService",
        "contract": {
          "stateTransitionControl": "EXPLICIT_ALLOWED_TRANSITION_BUTTONS",
          "scope": "SHARED_RENDERING_CAPABILITY",
          "fieldTypeControlMap": {
            "REFERENCE": "SAME_PARTITION_ENTITY_PICKER",
            "STRING": "TEXT_INPUT",
            "ENUM": "LOCALIZED_SELECT",
            "INTEGER": "INTEGER_INPUT",
            "ISO_DATE": "DATE_INPUT",
            "EMAIL": "EMAIL_INPUT",
            "DECIMAL_19_2": "DECIMAL_INPUT"
          },
          "unrestrictedStatusEditing": false,
          "enumDisplay": "BUSINESS_LOCALE_LABEL",
          "behaviorControlledByActiveBusiness": true,
          "projectionRule": "REPLACE_NOT_MERGE",
          "enumStorage": "CANONICAL_UPPERCASE_VALUE"
        }
      },
      {
        "objectId": "persistenceService",
        "instanceOf": "ContextualSharedService",
        "specialization": "PartitionedPersistenceService",
        "contract": {
          "logicalIsolation": "ONE_PARTITION_PER_BUSINESS",
          "keyRule": "No storage index or lookup may use entityId alone; duplicate entity IDs across business partitions are intentional isolation evidence.",
          "crossBusinessJoins": "PROHIBITED",
          "isolationGate": "SERVER_ENFORCED",
          "canonicalStorageKey": [
            "containerId",
            "businessAppId",
            "schemaVersion",
            "entityId",
            "recordId"
          ],
          "physicalService": "SHARED_FILE_DATABASE"
        }
      },
      {
        "objectId": "requestContextResolver",
        "instanceOf": "ContextualSharedService",
        "specialization": "RequestContextResolver",
        "contract": {
          "entityAuthorization": "entityId MUST be declared by the resolved business",
          "businessResolution": "SERVER_RESOLVES selectedUserId TO exactly one registered businessAppId and partition",
          "recordRoute": "/api/{selectedUserId}/records/{entityId}",
          "sessionBehavior": "DEMO_SELECTOR; NOT AUTHENTICATION",
          "submissionConsistency": "_activeEntity MUST equal route entityId",
          "crossBusinessOverride": "PROHIBITED",
          "transitionRoute": "/api/{selectedUserId}/records/{entityId}/{recordId}/transition"
        }
      },
      {
        "objectId": "administrationProjection",
        "instanceOf": "ContextualSharedService",
        "specialization": "AdministrationService",
        "contract": {
          "surfaceRequired": true,
          "surfaceType": "STANDALONE_NAVIGATION_VIEW",
          "route": "/administration",
          "navigationPosition": "BOTTOM_LEFT",
          "visibleForEveryDemoUser": true,
          "userAware": true,
          "stateOwnership": "ACTIVE_BUSINESS_SELF",
          "scope": "OWN_BUSINESS_ONLY",
          "persistence": "SURVIVES_PROCESS_RESTART",
          "reprojectOnUserChange": true,
          "projectionRule": "REPLACE_NOT_MERGE",
          "fields": [
            {
              "persisted": true,
              "labelKey": "BUSINESS_DISPLAY_NAME",
              "control": "TEXT_INPUT",
              "required": true,
              "editable": true,
              "id": "businessName"
            },
            {
              "persisted": true,
              "labelKey": "THEME",
              "control": "ALLOWED_THEME_SELECT",
              "required": true,
              "editable": true,
              "id": "theme"
            },
            {
              "persisted": true,
              "labelKey": "NOTIFICATIONS",
              "control": "LOCALIZED_ENABLED_DISABLED_SELECT",
              "required": true,
              "editable": true,
              "id": "notifications"
            },
            {
              "persisted": false,
              "labelKey": "LANGUAGE_LOCALE",
              "control": "READ_ONLY_TEXT",
              "source": "ACTIVE_BUSINESS_SELF",
              "editable": false,
              "id": "locale"
            },
            {
              "persisted": true,
              "labelKey": "SCHEMA_VERSION",
              "control": "READ_ONLY_TEXT",
              "source": "ACTIVE_BUSINESS_PARTITION",
              "editable": false,
              "id": "schemaVersion"
            },
            {
              "persisted": false,
              "labelKey": "PERSISTENCE_PARTITION",
              "control": "READ_ONLY_TEXT",
              "source": "SERVER_RESOLVED_CONTEXT",
              "editable": false,
              "id": "persistencePartition"
            }
          ],
          "actions": [
            {
              "validation": "REQUIRED_FIELDS_AND_ALLOWED_VALUES",
              "control": "PRIMARY_BUTTON",
              "auditEvents": [
                "THEME_CHANGED",
                "ADMINISTRATION_CHANGED"
              ],
              "writes": "ACTIVE_BUSINESS_PARTITION_ONLY",
              "id": "SAVE_ADMINISTRATION"
            }
          ],
          "accessWarningRequired": true,
          "accessWarningSource": "containerSelf.accessWarning",
          "labelsLocalizedByActiveBusiness": true,
          "auditResponsibility": "NONE_USE_AUDIT_NEURON",
          "acceptanceScenarios": [
            "Administration appears as a bottom-left navigation item for every demo user.",
            "Opening Administration renders every declared field and action; omission of the view or a required control is a build failure.",
            "Switching users while Administration is open reconstructs the Administration view for the newly active business without merging state.",
            "Saved business name, theme and notification preference survive a complete process restart and remain isolated from every other business.",
            "Locale, schema version and persistence partition are visible but cannot be edited.",
            "Every saved administrative mutation emits the declared partition-scoped audit event.",
            "The view visibly states that the demo selector is not production authentication."
          ]
        }
      },
      {
        "objectId": "auditService",
        "instanceOf": "ContextualSharedService",
        "specialization": "AuditService",
        "contract": {
          "scope": "SHARED_CAPABILITY_WITH_BUSINESS_PARTITION_CONTEXT",
          "eventFields": [
            "timestamp",
            "userId",
            "businessAppId",
            "entityId",
            "operation",
            "target"
          ],
          "administrationProducesAudit": false,
          "events": [
            "SEED_RECORD_CREATED",
            "RECORD_CREATED",
            "RECORD_DELETED",
            "STATE_TRANSITION",
            "THEME_CHANGED",
            "ADMINISTRATION_CHANGED",
            "DEMO_SEED_COMPLETED"
          ],
          "rule": "The business operation or persistence boundary emits audit events; Administration does not own auditing.",
          "ordinaryReadsAudited": false
        }
      },
      {
        "objectId": "seedService",
        "instanceOf": "ContextualSharedService",
        "specialization": "SeedService",
        "contract": {
          "referenceRule": "SEED_REFERENCES_RESOLVE_WITHIN_SAME_PARTITION",
          "recordSource": "DEMO_SEED",
          "seedVersion": "DEMO_SEED_V1",
